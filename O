    .link-card { display: flex; align-items: center; gap: 14px; background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; margin-bottom: 10px; text-decoration: none; color: var(--text); }
    .link-icon { width: 44px; height: 44px; border-radius: 12px; background: rgba(232,197,71,0.12); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .link-card strong { display: block; font-size: 0.95rem; }
    .link-card span { font-size: 0.8rem; color: var(--muted); }
    .invite-box { background: var(--card); border: 1px dashed var(--border); border-radius: 16px; padding: 22px; text-align: center; margin-bottom: 16px; }
    .invite-code { font-size: 1.5rem; font-weight: 700; color: var(--gold); letter-spacing: 1px; margin: 10px 0 16px; font-family: "Playfair Display", serif; }
    .info-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 0.92rem; }
    .info-row:last-child { border-bottom: none; }
    .info-label { color: var(--muted); }
    .info-value { font-weight: 600; text-align: right; max-width: 60%; word-break: break-all; }
    .modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.75); display: none; align-items: flex-end; justify-content: center; z-index: 300; padding: 16px; }
    .modal-bg.show { display: flex; }
    .modal { background: var(--card2); border: 1px solid var(--border); border-radius: 20px 20px 16px 16px; padding: 24px; width: 100%; max-width: 440px; max-height: 85vh; overflow-y: auto; }
    .modal h3 { color: var(--gold); margin-bottom: 8px; font-size: 1.2rem; }
    .modal p { font-size: 0.9rem; color: var(--muted); margin-bottom: 16px; }
    .modal label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 6px; }
    .modal input,.modal select { width: 100%; height: 46px; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0 14px; color: var(--text); font-size: 0.95rem; outline: none; margin-bottom: 14px; }
    .modal input:focus,.modal select:focus { border-color: var(--gold); }
    .modal-actions { display: flex; gap: 10px; margin-top: 8px; }
    /* Mobile-safe Add Bank modal: keep the complete form reachable and scrollable. */
    #bankModal { align-items: flex-start; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom)); }
