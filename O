<script src="app.js"></script>
<script>
    let currentUser = null, settings = {}, products = [], fullData = null, slide = 0, carTimer = null, balanceSlide = 0, balanceTouchStartX = 0;
    let liveSyncFingerprint = "";
    let liveSyncStarted = false;

    function hourGreeting() {
      const h = new Date().getHours();
      if (h < 12) return "Good morning,";
      if (h < 17) return "Good afternoon,";
      return "Good evening,";
    }
    function showPage(name) {
      document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
      const el = document.getElementById("page-" + name);
      if (el) el.classList.add("active");
      if(name==='inbox'){ loadInbox(); }
      window.scrollTo(0, 0);
    }
    function goSlide(i) {
      slide = i;
      const track = document.getElementById("carouselTrack");
      if (track) track.style.transform = "translateX(-" + (slide * 33.333) + "%)";
      document.querySelectorAll("#carouselDots span").forEach((d, idx) => d.classList.toggle("active", idx === slide));
      clearInterval(carTimer);
      carTimer = setInterval(function() { goSlide((slide + 1) % 3); }, 4500);
    }

    document.addEventListener("DOMContentLoaded", async function() {
      currentUser = getLoggedUser();
      if (!currentUser) { location.href = "login.html"; return; }
      try {
        await loadAll();
        startDashboardLiveSync();
        goSlide(0);
      } catch (e) {
        console.error(e);
        clearLoggedUser();
        location.href = "login.html";
      }
    });

    async function loadAll() {
      fullData = await fetchBin();
      const fresh = (fullData.users || []).find(function(u) { return u.email === currentUser.email; });
      if (!fresh) { clearLoggedUser(); location.href = "login.html"; return; }
      currentUser = fresh;
      setLoggedUser(currentUser);
      settings = fullData.settings || {};
      products = fullData.products || [];
      renderAll();
      liveSyncFingerprint = makeLiveSyncFingerprint(fullData, currentUser);
      document.getElementById("loading").style.display = "none";
      document.getElementById("app").style.display = "block";
      var liveBadge = document.getElementById("liveSyncBadge");
      if (liveBadge) liveBadge.style.display = "block";
    }

    function makeLiveSyncFingerprint(data, user) {
      return JSON.stringify({
        user: user || {},
        settings: data && data.settings ? data.settings : {},
        products: data && data.products ? data.products : [],
        withdrawals: (data && data.withdrawals ? data.withdrawals : []).filter(function(w) {
          return w && (w.email === (user && user.email) || w.user === (user && user.email));
        })
      });
    }

    function startDashboardLiveSync() {
      if (liveSyncStarted) return;
      liveSyncStarted = true;
      const handleDashboardSync = async function(latest) {
        if (!currentUser || !latest) return;
        const freshUser = (latest.users || []).find(function(u) { return u.email === currentUser.email; });
        if (!freshUser) return;

        const fingerprint = makeLiveSyncFingerprint(latest, freshUser);
        if (fingerprint === liveSyncFingerprint) return;

        fullData = latest;
        currentUser = freshUser;
        settings = latest.settings || {};
        products = latest.products || [];
        setLoggedUser(currentUser);
        liveSyncFingerprint = fingerprint;
        renderAll();

        // Re-bind modal data/buttons immediately if the admin changed it.
        if (document.getElementById("depositModal")?.classList.contains("show")) {
          openDeposit();
        }
        showToast("Live update received", 1600);
      };

      startFrontendSync(handleDashboardSync, 8000);
    }

    function initBalanceSlider(){
      const track=document.getElementById('balanceTrack'), dots=document.getElementById('balanceDots'); if(!track||!dots)return;
      dots.innerHTML=Array.from({length:3},function(_,i){return '<span class="'+(i===balanceSlide?'active':'')+'" onclick="setBalanceSlide('+i+')"></span>';}).join('');
      track.style.transform='translateX(-'+(balanceSlide*33.3333333333)+'%)';
      const slider=document.getElementById('balanceSlider'); if(slider&&!slider.dataset.bound){slider.dataset.bound='1';slider.addEventListener('touchstart',function(e){balanceTouchStartX=e.changedTouches[0].clientX},{passive:true});slider.addEventListener('touchend',function(e){const dx=e.changedTouches[0].clientX-balanceTouchStartX;if(Math.abs(dx)>35)moveBalanceSlide(dx<0?1:-1)},{passive:true});}
    }
    function setBalanceSlide(i){balanceSlide=Math.max(0,Math.min(2,i));initBalanceSlider()}
    function moveBalanceSlide(delta){setBalanceSlide((balanceSlide+delta+3)%3)}
    function calculateInvestmentBalance(data,user){
      // investmentBalance is the authoritative total once it has been recorded.
      // Do not add investments/payment submissions on top of it, otherwise the
      // same investment can be counted more than once.
      var stored=Number(user.investmentBalance);
      if(Number.isFinite(stored) && stored>0) return stored;

      // Legacy fallback for older accounts that do not yet have an
      // investmentBalance value. Claims are excluded because confirmed claims
      // are already represented by the stored balance when that field exists.
      var total=0;
      var investments=Array.isArray(user.investments)?user.investments:[];
      investments.forEach(function(i){
        var source=String(i.source||'').toLowerCase();
        var status=String(i.status||'confirmed').toLowerCase();
        if(source!=='claim' && !['pending','declined','rejected','cancelled'].includes(status)){
          total += Math.max(0,Number(i.amount||i.price||0));
        }
      });

      // Only use payment submissions as a legacy fallback when there are no
      // investment records. This prevents a submitted payment from being
      // counted again alongside an investment record for the same purchase.
      if(total===0 && investments.length===0){
        (data.paymentSubmissions||[]).forEach(function(p){
          var email=String(p.email||'').toLowerCase();
          var status=String(p.status||'').toLowerCase();
          if(email===String(user.email||'').toLowerCase() && ['reviewed','approved','confirmed'].includes(status)){
            total += Math.max(0,Number(p.amount||0));
          }
        });
      }
      return total;
    }

    function renderAll() {
      var name = currentUser.fullName || "User";
      var first = name.split(" ")[0];
      var initial = (first[0] || "U").toUpperCase();
      document.getElementById("greetLabel").textContent = hourGreeting();
      document.getElementById("greetName").textContent = first;
      document.getElementById("avatar").textContent = initial;

      var bal = Number(currentUser.balance || 0);
      document.getElementById("balanceAmount").textContent = money(bal);
      document.getElementById("pendingWithdrawAmount").textContent = money(pendingWithdrawTotal(currentUser));
      document.getElementById("investmentBalance").textContent = money(calculateInvestmentBalance(fullData, currentUser));
      initBalanceSlider();

      var refs = Number(currentUser.referrals || currentUser.totalReferrals || 0);
      // Earnings are separate from the available balance. Do not fall back to
      // balance here because that would make the Move Earnings action ambiguous.
      var earned = Number(currentUser.totalEarned ?? currentUser.inviteEarnings ?? 0);
      document.getElementById("totalReferrals").textContent = refs;
      document.getElementById("totalEarned").textContent = "₦" + earned.toLocaleString();

      var txs = currentUser.transactions || [];
      var txBox = document.getElementById("txList");
      if (!txs.length) {
        if (bal > 0) {
          txBox.innerHTML = '<div class="tx-item"><div><div class="tx-title">Welcome bonus</div><div class="tx-date">' +
            (currentUser.joined ? new Date(currentUser.joined).toLocaleDateString() : "") +
            '</div></div><div class="tx-amount plus">+₦' + bal.toLocaleString() + "</div></div>";
        } else {
          txBox.innerHTML = '<div class="empty">No transactions yet</div>';
        }
      } else {
        txBox.innerHTML = txs.slice().reverse().slice(0, 10).map(function(t) {
          var amt = Number(t.amount);
          var pending=String(t.status||'').toLowerCase()==='pending' || String(t.type||'').toLowerCase()==='withdrawal' && String(t.status||'').toLowerCase()==='pending';
          return '<div class="tx-item '+(pending?'pending-row':'')+'"><div><div class="tx-title">' + escapeHtml(t.memo || t.title || t.type || "Transaction") + (pending?'<span class="pending-badge">PENDING</span>':'') +
            '</div><div class="tx-date">' + (t.date ? new Date(t.date).toLocaleDateString() : "") +
            '</div></div><div class="tx-amount ' + (pending ? "pending" : (amt >= 0 ? "plus" : "minus")) + '">' +
            (amt >= 0 ? "+" : "") + money(Math.abs(amt)) + "</div></div>";
        }).join("");
      }

      var pBox = document.getElementById("productsList");
      if (!products.length) {
        pBox.innerHTML = '<div class="empty">No packages available</div>';
      } else {
        pBox.innerHTML = products.map(function(p) {
          return '<div class="product-card"><div class="product-top"><span class="product-name">' + p.name +
            '</span><span>' + (p.badge || "") + '</span></div><div class="product-desc">' + (p.desc || "") +
            '</div><div class="product-meta"><span>Invest: <strong>₦' + Number(p.price).toLocaleString() +
            '</strong></span><span>Profit: <strong>₦' + Number(p.profit).toLocaleString() +
            '</strong></span></div><button class="btn btn-gold" style="width:100%;" onclick="investProduct(\'' +
            p.id + "')\">Invest Now</button><button class=\"btn btn-dark\" style=\"width:100%;margin-top:8px;\" onclick=\"openClaim()\">Verify &amp; Claim Product</button></div>";
        }).join("");
      }

      var sBox = document.getElementById("supportLinks");
      var sHtml = "";
      if (settings.whatsapp) sHtml += '<a class="link-card" href="' + settings.whatsapp + '" target="_blank" rel="noopener"><div class="link-icon">📱</div><div><strong>WhatsApp Support</strong><span>Chat with us</span></div></a>';
      if (settings.telegram) sHtml += '<a class="link-card" href="' + settings.telegram + '" target="_blank" rel="noopener"><div class="link-icon">✈️</div><div><strong>Telegram</strong><span>Message support</span></div></a>';
      if (settings.telegramChannel) sHtml += '<a class="link-card" href="' + settings.telegramChannel + '" target="_blank" rel="noopener"><div class="link-icon">📢</div><div><strong>Telegram Channel</strong><span>News & updates</span></div></a>';
      sBox.innerHTML = sHtml || '<div class="empty">Support links will appear when set by admin</div>';

      document.getElementById("platBank").textContent = settings.bankName || "—";
      document.getElementById("platName").textContent = settings.accountName || "—";
      document.getElementById("platAcct").textContent = settings.bankAccount || "—";

      var code = currentUser.referralCode || currentUser.id || "—";
      document.getElementById("inviteCode").textContent = code; document.getElementById("inviteLink").textContent = location.origin + '/signup.html?ref=' + encodeURIComponent(code);
      document.getElementById("inviteRefs").textContent = refs;
      document.getElementById("inviteEarn").textContent = "₦" + Number(currentUser.inviteEarnings || 0).toLocaleString();

      document.getElementById("profName").textContent = name;
      document.getElementById("profEmail").textContent = currentUser.email || "—";
      document.getElementById("profJoined").textContent = currentUser.joined ? new Date(currentUser.joined).toLocaleDateString() : "—";
      document.getElementById("profStatus").textContent = currentUser.status || "Active";
      document.getElementById("profCode").textContent = code;
      document.getElementById("profBank").textContent = (currentUser.bankName || (currentUser.withdrawalAccount||{}).bankName) || "Not set";
      document.getElementById("profAcct").textContent = (currentUser.bankAccount || (currentUser.withdrawalAccount||{}).accountNumber) || "Not set";
    }


