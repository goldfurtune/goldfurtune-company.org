    async function submitWithdraw(){
      var amount=Number(document.getElementById('wdAmount').value);
      if(!amount || amount<50000){showToast('Amount is not eligible for withdrawal. Minimum withdrawal is ₦50,000.');return;}
      if(amount>4000000){showToast('Withdrawal amount cannot exceed ₦4,000,000.');return;}
      var withdrawalAccount=getConfirmedWithdrawalAccount(currentUser);
      if(!withdrawalAccount.bankName || !/^\d{10}$/.test(withdrawalAccount.bankAccount) || !withdrawalAccount.bankHolder){showToast('Confirm your bank details before withdrawing.');return;}
      if(amount>Number(currentUser.balance||0)){showToast('Insufficient available balance.');return;}
      const btn=document.getElementById('withdrawConfirmBtn'); if(btn){btn.disabled=true;btn.textContent='Processing…';}
      closeModals();
      startWithdrawalProcessing(amount, async function(){
        try{
          stopFrontendSync();
          var now=new Date().toISOString();
          fullData.withdrawals=fullData.withdrawals||[];
          fullData.withdrawals.push({id:'WD'+Date.now(),email:currentUser.email,fullName:currentUser.fullName,amount:amount,bankName:withdrawalAccount.bankName,bankAccount:withdrawalAccount.bankAccount,bankHolder:withdrawalAccount.bankHolder,status:'pending',date:now,balanceDebited:true});
          var idx=fullData.users.findIndex(function(u){return u.email===currentUser.email;});
          if(idx<0)throw new Error('User not found');
          fullData.users[idx].balance=Math.max(0,Number(fullData.users[idx].balance||0)-amount);
          fullData.users[idx].transactions=fullData.users[idx].transactions||[];
          fullData.users[idx].transactions.push({id:'TXWD'+Date.now(),title:'Pending withdrawal',memo:'Withdrawal to '+withdrawalAccount.bankName,amount:-amount,date:now,type:'withdrawal',status:'pending',withdrawalId:fullData.withdrawals[fullData.withdrawals.length-1].id});
          await saveBin(fullData);
          document.getElementById('withdrawProcessing').classList.remove('show');
          showToast('Your money will be credited to your bank account within 20 mins.');
          if(btn){btn.disabled=false;btn.textContent='Confirm Withdraw';}
          await loadAll(); startDashboardLiveSync();
        }catch(e){
          document.getElementById('withdrawProcessing').classList.remove('show');
          if(btn){btn.disabled=false;btn.textContent='Confirm Withdraw';}
          startDashboardLiveSync(); showToast('Withdrawal could not be submitted. Please try again.'); console.error(e);
        }
      });
    }

