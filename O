    function buildActivityEvents(data){
      const events=[];
      (data.withdrawals||[]).forEach(w=>{
        if(!w || !w.fullName || !Number(w.amount)) return;
        const amount=Number(w.amount);
        if(amount<50000 || amount>4000000) return;
        events.push({id:'wd:'+w.id, name:w.fullName, type:'just requested a withdrawal', amount:'₦'+amount.toLocaleString()});
      });
      (data.users||[]).forEach(u=>{
        (u.transactions||[]).forEach((tx,i)=>{
          if(String(tx.type||'').toLowerCase()!=='credit') return;
          if(!/referral/i.test(String(tx.title||tx.memo||''))) return;
          const amount=Number(tx.amount||0);
          if(amount<=0) return;
          events.push({id:'rf:'+u.id+':'+i, name:u.fullName||'A customer', type:'just earned a referral reward', amount:'+₦'+amount.toLocaleString()});
        });
      });
      return events;
    }
    function hideActivity(){
      const el=document.getElementById('activityPopup'); if(!el) return;
      el.classList.remove('show');
      if(activityHideTimer){clearTimeout(activityHideTimer);activityHideTimer=null;}
    }
    function showActivity(ev){
      const el=document.getElementById('activityPopup'); if(!el) return;
      document.getElementById('communityAvatar').textContent=(ev.name||'GF').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();
      document.getElementById('communityName').textContent=ev.name;
      document.getElementById('communityType').textContent=ev.type;
      document.getElementById('communityAmount').textContent=ev.amount;
      el.classList.add('show');
      if(activityHideTimer) clearTimeout(activityHideTimer);
      activityHideTimer=setTimeout(hideActivity,3000);
    }
    function scheduleActivityPopup(){
      setTimeout(()=>{
        if(document.hidden){scheduleActivityPopup();return;}
        if(activityEvents.length){
          let pool=activityEvents.filter(e=>!activityUsed.has(e.id));
          if(!pool.length){activityUsed.clear();pool=activityEvents.slice();}
          const ev=pool[Math.floor(Math.random()*pool.length)];
          activityUsed.add(ev.id);
          showActivity(ev);
        }
        scheduleActivityPopup();
      },[10000,12000,15000][Math.floor(Math.random()*3)]);
    }
    function refreshActivityEvents(data){ activityEvents=buildActivityEvents(data); }
    refreshActivityEvents(fullData);
    scheduleActivityPopup();

</script>
