    async function moveEarnings(){
      var btn=document.getElementById('moveEarningsBtn'),msg=document.getElementById('earningsMsg');
      if(!btn || btn.disabled) return;
      btn.disabled=true;
      msg.textContent='Processing transfer…';
      try{
        stopFrontendSync();
        // Always reload the shared data immediately before changing money so
        // an old dashboard tab cannot transfer a stale amount.
        var data=await fetchBin();
        var idx=(data.users||[]).findIndex(function(u){return u.email===currentUser.email;});
        if(idx<0) throw new Error('User not found');
        var user=data.users[idx];
        var earnings=getEarningsAmount(user);
        if(earnings<30000){
          msg.textContent='Amount is not yet eligible to be moved to balance.';
          btn.disabled=false; startDashboardLiveSync(); return;
        }

        var now=new Date().toISOString();
        var oldBalance=Math.max(0,Number(user.balance)||0);
        user.balance=oldBalance+earnings;
        // Clear the earnings bucket after a successful transfer so the same
        // earnings cannot be moved twice.
        user.totalEarned=0;
        if(user.inviteEarnings!==undefined) user.inviteEarnings=0;
        user.transactions=Array.isArray(user.transactions)?user.transactions:[];
        user.transactions.push({
          id:'TXEARN'+Date.now(),
          title:'Earnings moved to balance',
          memo:'Earnings transfer',
          amount:earnings,
          date:now,
          type:'credit',
          status:'confirmed'
        });
        await saveBin(data);

        fullData=data;
        currentUser=user;
        setLoggedUser(currentUser);
        liveSyncFingerprint=makeLiveSyncFingerprint(fullData,currentUser);
        renderAll();
        msg.textContent='Transfer complete. ₦'+earnings.toLocaleString('en-NG')+' has been added to your available balance.';
        setTimeout(closeEarnings,1800);
      }catch(e){
        console.error(e);
        msg.textContent='Unable to move earnings right now. Please try again.';
      }finally{
        btn.disabled=false;
        startDashboardLiveSync();
      }
    }
