      // amount shown is the current stored earnings amount.
      try{
        var latest=await fetchBin();
        var fresh=(latest.users||[]).find(function(u){return u.email===currentUser.email;});
        if(fresh){ fullData=latest; currentUser=fresh; setLoggedUser(currentUser); renderAll(); }
      }catch(e){ console.error(e); }
      var amount=getEarningsAmount(currentUser);
      document.getElementById('earningsText').textContent=amount>=30000
        ? 'Eligible earnings: ₦'+amount.toLocaleString('en-NG')+'. You can move the full amount to your available balance.'
        : 'Amount is not yet eligible to be moved to balance. Minimum is ₦30,000.';
